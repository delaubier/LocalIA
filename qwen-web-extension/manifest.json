{
  "manifest_version": 3,
  "name": "LocalAI",
  "version": "1.0.0",
  "description": "Une intelligence artificielle multimodale et privée tournant localement dans votre navigateur via WebLLM.",
  "action": {
    "default_title": "Ouvrir LocalAI"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "unlimitedStorage"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
